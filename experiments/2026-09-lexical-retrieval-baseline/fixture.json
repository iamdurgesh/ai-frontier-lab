      "text": "A checkpoint saves task state. A worker can resume a failed task from saved state."
    },
    {
      "id": "retry",
      "text": "A retry repeats a failed request. Use a finite retry limit and backoff."
    },
    {
      "id": "permissions",
      "text": "Tool permissions restrict allowed actions. A write action requires explicit approval."
    },
    {
      "id": "retrieval",
      "text": "Retrieval ranks documents for a query. Lexical search matches words in the query."
    },
    {
      "id": "budget",
      "text": "A token budget limits model usage. Stop execution when the budget is exhausted."
    },
    {
      "id": "cancellation",
      "text": "Cancellation asks a running task to stop. External actions already in flight may finish."
    },
    {
      "id": "deduplication",
      "text": "An idempotency key identifies a request. Deduplication prevents repeating its side effect."
    },
    {
      "id": "tracing",
      "text": "Tracing records task events and timing. Do not record secrets or submitted payloads."
    }
